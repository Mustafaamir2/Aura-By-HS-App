# Keeps the build context small and, more importantly, keeps secrets out of
# the image. Anything listed here is never sent to the Docker daemon, so it
# cannot end up in a layer even by accident.

# Secrets — these belong in the host's environment, never baked into an image
.env
.env.*
!.env.example

# Virtual environments: host-specific, often hundreds of MB, and would shadow
# the packages installed inside the image
.venv
.venv*
venv

# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests and dev-only dependencies are not needed to serve requests
tests/
requirements-dev.txt
pytest.ini

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git metadata
.git
.gitignore
